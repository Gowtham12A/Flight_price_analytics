      <aliases enabled='yes' />
      <column caption='Price(Numeric)' datatype='real' name='[Calculation_1380353333879255040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT([price])' />
      </column>
      <column caption='Is Cheap option' datatype='boolean' name='[Calculation_1380353333879554049]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1380353333879255040] &lt;= { FIXED [route ],[class] : MEDIAN([Calculation_1380353333879255040]) } * 0.85' />
      </column>
      <column caption='Median price by route and class' datatype='real' name='[Calculation_1380353333880279042]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [route ],[class] : MEDIAN([Calculation_1380353333879255040]) }' />
      </column>
      <column caption='Spread IQR' datatype='real' name='[Calculation_1380353333880664067]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [route ],[class] : PERCENTILE([Calculation_1380353333879255040],0.9) } &#13;&#10;-&#13;&#10;{ FIXED [route ],[class] : PERCENTILE([Calculation_1380353333879255040],0.1) }' />
      </column>
      <column caption='Stops(Label)' datatype='string' name='[Calculation_1380353333881200644]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([stops]) + &quot; stops&quot;' />
      </column>
      <column caption='% Cheap option' datatype='real' name='[Calculation_1380353333882540038]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( IF [Calculation_1380353333879554049] THEN 1 END ) / COUNT([Calculation_1380353333879255040])' />
      </column>
      <column caption='Filter by route' datatype='boolean' name='[Calculation_1380353333883572235]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Route Parameter] = &quot;All&quot; THEN TRUE&#13;&#10;ELSE [route ] = [Parameters].[Route Parameter]&#13;&#10;END' />
      </column>
      <column caption='Filter by airline' datatype='boolean' name='[Calculation_1380353333883760652]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Airline Parameter] = &quot;All&quot; THEN TRUE&#13;&#10;ELSE [airline] = [Parameters].[Airline Parameter]&#13;&#10;END' />
      </column>
      <column caption='Filter by class' datatype='boolean' name='[Calculation_1380353333883940877]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Class Parameter] = &quot;All&quot; THEN TRUE&#13;&#10;ELSE [class] = [Parameters].[Class Parameter]&#13;&#10;END' />
      </column>
      <column caption='days_left_filter' datatype='boolean' name='[Calculation_1380353333884170254]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[days_left] = [Parameters].[Days Left Parameter]' />
      </column>
      <column caption='Booking_Window_bucket' datatype='string' name='[Calculation_633881695858929664]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [days_left] &lt;= 7 THEN &quot;Immediate&quot;&#13;&#10;ELSEIF [days_left] &lt;= 14 THEN &quot;Two weeks&quot;&#13;&#10;ELSEIF [days_left] &lt;= 21 THEN &quot;Three weeks&quot;&#13;&#10;ELSEIF [days_left] &lt;= 28 THEN &quot;Four weeks&quot;&#13;&#10;ELSE &quot;More than a Month&quot;&#13;&#10;END' />
      </column>
      <column caption='Median price' datatype='real' name='[Calculation_633881695864340481]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_MEDIAN(AVG([price]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Average duration of flights' datatype='real' name='[Calculation_633881695864684546]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([duration(hrs)])' />
      </column>
      <column caption='Airline avg price' datatype='real' name='[Calculation_633881695865143299]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [airline] : AVG([price]) }' />
      </column>
      <column caption='Cheapest Airline' datatype='string' name='[Calculation_633881695868936196]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_633881695865143299] = { MIN([Calculation_633881695865143299]) }&#13;&#10;THEN [airline]&#13;&#10;END' />
      </column>
      <column caption='Expensive Airline' datatype='string' name='[Calculation_633881695870455813]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_633881695865143299] = { MAX([Calculation_633881695865143299]) }&#13;&#10;THEN [airline]&#13;&#10;END' />
      </column>
      <column caption='Best route efficiency' datatype='real' name='[Calculation_633881695870857222]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([trip efficiency])' />
      </column>
      <column datatype='string' hidden='true' name='[F15]' role='dimension' type='nominal' />
